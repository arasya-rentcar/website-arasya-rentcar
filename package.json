    "prebuild": "tsx scripts/validate-env.ts && tsx scripts/content-snapshot.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:types": "tsx scripts/gen-db-types.ts",
    "db:check-migrations": "tsx scripts/check-migrations.ts",
    "check:service-role-leak": "tsx scripts/check-service-role-leak.ts",
    "check:jsonld": "tsx scripts/check-jsonld.ts",
    "check:mdx": "tsx scripts/check-mdx.ts",
    "check:chauffeur-marker": "tsx scripts/check-chauffeur-marker.ts",
    "check:chauffeur-phrase": "tsx scripts/check-chauffeur-phrase.ts",
    "check:bundle-budget": "tsx scripts/check-bundle-budget.ts",
    "check:forbidden-phrases": "tsx scripts/lint-forbidden-phrases.ts",
