# Supabase CLI local workspace artifacts.
# Keep `config.toml`, `migrations/`, `functions/`, and `seed.sql` tracked.

# Local branch sandboxes created by `supabase db branch`.
.branches/

# Scratch/temp workspace used by the CLI.
.temp/

# Local dotenv overrides loaded by the CLI (never commit secrets).
.env
.env.*
!.env.example

# OS cruft
.DS_Store
