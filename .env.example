# Arasya RentCar — Environment Variables
# Source of truth: .kiro/specs/arasya-rentcar-website/design.md §20
# Copy this file to `.env.local` (gitignored) and fill in real values.
# `scripts/validate-env.ts` runs at the start of `pnpm build` and fails the
# build if any `# required` var is missing (R17.10).

# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------
# Absolute site origin used for canonical URLs, OG image URLs, and sitemap.
# Must include protocol and no trailing slash (e.g. https://arasyarentcar.com).
# required
NEXT_PUBLIC_SITE_URL=

# -----------------------------------------------------------------------------
# WhatsApp
# -----------------------------------------------------------------------------
# Official admin WhatsApp number in E.164 format (e.g. +628123456789).
# Used by buildWhatsAppUrl() and as the target for booking hand-offs.
# required
ARASYA_WHATSAPP_NUMBER=

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
# Supabase project URL (https://<project-ref>.supabase.co).
# required
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (read-only) key; safe to expose to the browser and used for
# public reads from both client and server.
# required
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key; server-only. Used for booking writes and admin
# notifications. MUST NEVER be imported from a Client Component (R21.8).
# required
SUPABASE_SERVICE_ROLE_KEY=

# Supabase project reference (the `<project-ref>` portion of the project URL).
# Used only by `pnpm db:types` when regenerating `types/database.ts` against a
# remote project. Local dev runs `pnpm db:types -- --local` and does not need
# this value.
# optional
SUPABASE_PROJECT_ID=

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Pepper mixed into the SHA-256 hash of the requester IP before it is stored
# in `leads.ip_hash` and `rate_limit.ip_hash`. Keep long and random.
# required
LEAD_IP_HASH_SALT=

# -----------------------------------------------------------------------------
# Revalidation
# -----------------------------------------------------------------------------
# Shared secret required in the `x-revalidate-secret` header on POSTs to
# `/api/revalidate`. Anything else returns 401.
# required
REVALIDATE_SECRET=

# -----------------------------------------------------------------------------
# Admin Notifications
# -----------------------------------------------------------------------------
# Optional outbound webhook called fire-and-forget after a booking is stored,
# so the admin gets a push/email/Slack notification. POST with a JSON payload
# containing leadId + the booking fields enumerated in R12.6. 5-second timeout.
# optional
ADMIN_NOTIFICATION_WEBHOOK_URL=

# Optional shared secret. When set, requests carry
# `Authorization: Bearer <secret>` so the webhook receiver can verify the
# request originated from this app.
# optional
ADMIN_NOTIFICATION_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Chat Widget
# -----------------------------------------------------------------------------
# Optional third-party chat widget identifier (e.g. Tawk.to, Crisp). Loaded
# lazily and consent-gated; leave blank to disable the widget entirely.
# optional
CHAT_WIDGET_ID=

# Optional third-party chat widget script URL. When set AND the user has given
# cookie consent, the script is loaded into <head>. Leave empty to disable the
# widget entirely. Examples: https://client.crisp.chat/l.js, https://embed.tawk.to/...
# optional
NEXT_PUBLIC_CHAT_WIDGET_SCRIPT_URL=

# -----------------------------------------------------------------------------
# Analytics
# -----------------------------------------------------------------------------
# Plausible domain or GA measurement id. Consent-gated via the analytics
# client wrapper; leave blank to disable analytics.
# optional
ANALYTICS_ID=

# Public Plausible domain used by `lib/analytics/client.ts` to gate event
# emission. When set AND the Visitor has granted consent AND DoNotTrack is
# off, the Plausible script is loaded by `app/[locale]/layout.tsx` (task
# 11.3) and `trackEvent()` calls fire. Leave blank to disable analytics
# entirely (dev / preview default).
# Example: arasyarentcar.com
# optional
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Public client-side display copy of the admin WhatsApp number. Read by the booking
# confirmation screen so visitors see the official number after a successful submission.
# The authoritative server-only value is ARASYA_WHATSAPP_NUMBER.
NEXT_PUBLIC_ARASYA_WHATSAPP_NUMBER=+628123456789
