# Supabase — Project Settings > API Keys
#
# Use a project dedicated to this marketing site. Do NOT point it at the
# operations database (orders/invoices/customers): the publishable key below is
# served to every visitor's browser, so it must only ever reach content tables.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Publishable key — sb_publishable_… (replaces the legacy `anon` JWT).
# Public by design: it is embedded in the browser bundle. RLS is what protects
# the data, not this key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key — sb_secret_… (replaces the legacy `service_role` JWT). Bypasses
# RLS entirely.
# Server-only: seeding, and Content Studio writes after the caller has been
# verified against the `admins` allowlist. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Seeded into `admins` by `npm run db:seed`. Sign-up is disabled in Supabase
# Auth, so this is how the first Content Studio login is created.
#
# QUOTE THE PASSWORD if it contains '#' — dotenv reads an unquoted # as the
# start of a comment and the value silently becomes empty, which makes the seed
# skip the admin bootstrap without erroring.
ADMIN_EMAIL=
ADMIN_PASSWORD=''

# Shared secret for the on-demand revalidation endpoint. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
REVALIDATE_SECRET=

# Vercel deploy hook. OPTIONAL — publishing is correct without it.
# Project Settings → Git → Deploy Hooks → create one on `main`.
#
# Content Studio calls this after publishing a page at a NEW address (first
# publication, or a slug that moved), purely so the URL joins the prerendered
# set and the first visitor gets a cached page instead of paying for the render.
# The page is live either way — routes use `dynamicParams = true`, so an address
# the current build never saw still renders on its first request.
VERCEL_DEPLOY_HOOK_URL=

# Canonical host for this deployment. Overrides settings.siteUrl from the
# database, so the same content renders correct canonicals/hreflang/OG/JSON-LD
# on a staging domain, a preview URL, and production. Omit on production to use
# the value stored in the CMS. No trailing slash.
NEXT_PUBLIC_SITE_URL=

# Indexing switch. Defaults to OFF: without it robots.txt disallows everything
# and every page sends noindex.
#
# Set to true ONLY on the final production domain. An indexed staging domain
# costs a full domain migration to undo (301s + Search Console change of
# address + a ranking dip); an un-indexed production deploy costs one redeploy.
NEXT_PUBLIC_ALLOW_INDEXING=
